#!/bin/bash

if test $UID -ne 0; then
    echo "You must be root to run this script." 1>&2
    exit 1
fi

if test -b /dev/sdb; then
    DEV=/dev/sdb
    DEV1=/dev/sdb1
elif test -b /dev/vdb; then
    DEV=/dev/vdb
    DEV1=/dev/vdb1
else
    echo "Second disk does not exist or is not a block device file." 1>&2
    exit 1
fi

test -b $DEV1 > /dev/null 2>&1
if test $? -ne 0; then
    echo 'start=2048, type=83' | sudo sfdisk $DEV
fi

apt -y install hfsplus hfsprogs
mkfs.hfsplus $DEV1
mkdir /mnt/sdb1
mount $DEV1 /mnt/sdb1
cp flag /mnt/sdb1/
umount /mnt/sdb1
rm -fr /mnt/sdb1
apt -y purge hfsplus hfsprogs
